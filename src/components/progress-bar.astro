<div id="progress-bar" class="progress-container">
  <div class="progress-bar"></div>
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    const progressBar = document.querySelector('.progress-bar') as HTMLElement;
    const progressContainer = document.querySelector('.progress-container') as HTMLElement;
    
    if (!progressBar || !progressContainer) return;
    
    // Hide initially
    progressContainer.style.opacity = '0';
    
    // Show progress bar on navigation start
    document.addEventListener('astro:before-preparation', () => {
      progressContainer.style.opacity = '1';
      progressBar.style.width = '0%';
      
      // Animate to 30% quickly to show something is happening
      setTimeout(() => {
        progressBar.style.width = '30%';
      }, 50);
      
      // Then move to 70% more slowly
      setTimeout(() => {
        progressBar.style.width = '70%';
      }, 300);
    });
    
    // Complete the progress bar when navigation is done
    document.addEventListener('astro:after-swap', () => {
      progressBar.style.width = '100%';
      
      // Hide after completion
      setTimeout(() => {
        progressContainer.style.opacity = '0';
        
        // Reset width after fade out
        setTimeout(() => {
          progressBar.style.width = '0%';
        }, 300);
      }, 300);
    });
  });
</script>

<style>
  .progress-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    z-index: 9999;
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  
  .progress-bar {
    height: 100%;
    width: 0%;
    background: linear-gradient(to right, #3b82f6, #1d4ed8);
    transition: width 0.3s ease-out;
  }
</style> 