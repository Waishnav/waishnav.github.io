---
interface Props {
  href: string;
  newTab?: boolean;
}

const { href, newTab } = Astro.props;

const isActive =
  href === "/"
    ? Astro.url.pathname === "/"
    : Astro.url.pathname.startsWith(href);
---

<a
  href={href}
  target={newTab ? "_blank" : undefined}
  rel={newTab ? "noopener noreferrer" : undefined}
  class:list={[
    "font-handwriting font-medium hover:text-gray-800 transition-colors",
    "text-sm sm:text-base",
    isActive ? "text-gray-800" : "",
  ]}
>
  <slot />
</a>
