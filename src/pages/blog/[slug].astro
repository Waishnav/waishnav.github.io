<style>
  /* Add styles to handle long URLs and prevent overflow on mobile */
  :global(.prose a) {
    word-break: break-word;
    overflow-wrap: break-word;
    hyphens: auto;
  }
  
  /* Additional responsive adjustments for the blog post */
  @media (max-width: 640px) {
    :global(.prose p) {
      margin-bottom: 1em;
    }
    
    :global(.prose ul),
    :global(.prose ol) {
      padding-left: 1.5em;
    }
    
    :global(.prose pre) {
      margin: 1.5em 0;
      padding: 0.75rem;
      font-size: 0.875rem;
      overflow-x: auto;
    }
    
    :global(.prose img) {
      margin: 1.5em 0;
    }
  }
</style> 
