  <!-- Go to Top Button -->
  <button
    id="go-to-top"
    class="fixed bottom-6 left-6 z-50 w-12 h-12 rounded-full bg-white shadow-md flex items-center justify-center border border-gray-200 hover:bg-gray-50 transition-colors opacity-0 invisible"
    aria-label="Go to top"
  >
    <svg
      xmlns="http://www.w3.org/2000/svg"
      class="h-6 w-6 text-gray-700"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M5 10l7-7m0 0l7 7m-7-7v18"
      />
    </svg>
  </button>
</Layout>

<style>
  /* Add styles to handle long URLs and prevent overflow on mobile */
  :global(.prose a) {
    word-break: break-word;
    overflow-wrap: break-word;
    hyphens: auto;
  }
  
  /* Additional responsive adjustments for the blog post */
  @media (max-width: 640px) {
    :global(.prose p) {
      margin-bottom: 1em;
    }
    
    :global(.prose ul),
    :global(.prose ol) {
      padding-left: 1.5em;
    }
    
    :global(.prose pre) {
      margin: 1.5em 0;
      padding: 0.75rem;
      font-size: 0.875rem;
      overflow-x: auto;
    }
    
    :global(.prose img) {
      margin: 1.5em 0;
    }
  }
  
  /* Go to Top button styles */
  #go-to-top.visible {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.3s, visibility 0.3s;
  }
  
  #go-to-top {
    transition: opacity 0.3s, visibility 0.3s;
  }
</style>

<script>
  // Initialize the table of contents functionality
  let updateActiveHeading: (() => void) | null = null;
  let scrollListenerActive = true;
  let hideTimeout: number | null = null;
  
  function initTableOfContents() {
    const tocContainer = document.querySelector('.toc-container');
    const tocButton = document.getElementById('toc-button');
    const tocContent = document.getElementById('toc-content');
    const tocProgress = document.getElementById('toc-progress');
    const headingElements = Array.from(document.querySelectorAll('h2, h3, h4, h5, h6'));
    
    if (!tocButton || !tocContent || !tocProgress || headingElements.length === 0) return;
    
    // Function to show the TOC
    const showTOC = () => {
      if (hideTimeout) {
        clearTimeout(hideTimeout);
        hideTimeout = null;
      }
      tocContent.classList.remove('hidden');
    };
    
    // Function to hide the TOC with delay
    const hideTOC = () => {
      // Only hide if neither the button nor the content is being hovered
      if (!tocButton.matches(':hover') && !tocContent.matches(':hover')) {
        hideTimeout = window.setTimeout(() => {
          tocContent.classList.add('hidden');
        }, 500);
      }
    };
    
    // Show TOC when hovering over button or content
    tocButton.addEventListener('mouseenter', showTOC);
    tocContent.addEventListener('mouseenter', showTOC);
    
    // Set up hide timeout when leaving either element
    tocButton.addEventListener('mouseleave', () => {
      console.log('mouseleave');
    });
    tocContent.addEventListener('mouseleave', hideTOC);
    
    // Close TOC when clicking outside
    document.addEventListener('click', (e) => {
      const target = e.target as Node;
      if (tocButton && !tocButton.contains(target) && 
          tocContent && !tocContent.contains(target)) {
        tocContent.classList.add('hidden');
      }
    });
    
    // Handle clicks on TOC links
    const tocLinks = document.querySelectorAll('.toc-item a');
    tocLinks.forEach(link => {
      link.addEventListener('click', (e) => {
        // Temporarily disable scroll listener to prevent interference
        scrollListenerActive = false;
        
        // Get the clicked heading's ID from the href
        const href = (e.currentTarget as HTMLAnchorElement).getAttribute('href');
        if (!href) return;
        
        const headingId = href.substring(1); // Remove the # character
        
        // Update active class in TOC
        tocLinks.forEach(l => l.parentElement?.classList.remove('active'));
        (e.currentTarget as HTMLElement).parentElement?.classList.add('active');
        
        // Hide TOC after clicking on mobile
        if (window.innerWidth < 768) {
          tocContent.classList.add('hidden');
        }
        
        // Re-enable scroll listener after navigation completes
        setTimeout(() => {
          scrollListenerActive = true;
        }, 500); // Wait for scroll to complete
      });
    });
    
    // Update active heading and progress on scroll
    updateActiveHeading = () => {
      if (!scrollListenerActive) return;
      
      // Find the current visible heading using Intersection Observer logic
      const scrollPosition = window.scrollY;
      const viewportHeight = window.innerHeight;
      const scrollBottom = scrollPosition + viewportHeight;
      
      // Find the heading that's closest to 1/4 of the viewport from the top
      const targetPosition = scrollPosition + viewportHeight * 0.25;
      
      let activeHeading = null;
      let closestDistance = Infinity;
      
      headingElements.forEach((heading, index) => {
        const element = heading as HTMLElement;
        const headingTop = element.offsetTop;
        const distance = Math.abs(headingTop - targetPosition);
        
        // If this heading is closer to the target position than the current closest
        if (distance < closestDistance && headingTop <= scrollBottom) {
          closestDistance = distance;
          activeHeading = index - 1;
        }
      });
      
      // Update active class in TOC
      const tocItems = document.querySelectorAll('.toc-item');
      tocItems.forEach(item => item.classList.remove('active'));
      
      if (activeHeading !== null && tocItems[activeHeading]) {
        tocItems[activeHeading].classList.add('active');
      }
      
      // Update progress circle
      const scrollPercentage = Math.min(
        100,
        Math.round((scrollPosition / (document.body.scrollHeight - window.innerHeight)) * 100)
      );
      tocProgress.style.background = `conic-gradient(#3b82f6 ${scrollPercentage}%, transparent 0%)`;
    };
    
    window.addEventListener('scroll', updateActiveHeading);
    updateActiveHeading(); // Initial update
  }

  // Go to Top button functionality
  function initGoToTopButton() {
    const goToTopButton = document.getElementById('go-to-top');
    
    if (!goToTopButton) return;
    
    // Show button when scrolled down
    window.addEventListener('scroll', () => {
      // Show button when scrolled down more than 300px
      if (window.scrollY > 300) {
        goToTopButton.classList.add('visible');
      } else {
        goToTopButton.classList.remove('visible');
      }
    });
    
    // Scroll to top when clicked
    goToTopButton.addEventListener('click', () => {
      // Smooth scroll to top
      window.scrollTo({
        top: 0,
        behavior: 'smooth'
      });
    });
  }

  // Run on initial page load
  document.addEventListener('DOMContentLoaded', () => {
    initTableOfContents();
    initGoToTopButton();
  });
  
  // Re-run when navigating with View Transitions
  document.addEventListener('astro:page-load', () => {
    initTableOfContents();
    initGoToTopButton();
  });
  
  // Clean up event listeners when leaving the page
  document.addEventListener('astro:before-preparation', () => {
    if (updateActiveHeading) {
      window.removeEventListener('scroll', updateActiveHeading);
    }
    if (hideTimeout) {
      clearTimeout(hideTimeout);
    }
  });
</script> 
