{
  "git_path": "/src/content/projects/",
  "file_extension": ".md",
  "filename_pattern": "",
  "collection_type": "flat",
  "frontmatter_schema": [
    {
      "name": "title",
      "type": "title",
      "label": "Title",
      "required": true
    },
    {
      "name": "order",
      "type": "number",
      "label": "Order"
    },
    {
      "name": "url",
      "type": "url",
      "label": "Url"
    },
    {
      "name": "users",
      "type": "number",
      "label": "Users"
    },
    {
      "name": "description",
      "type": "richtext",
      "label": "Description"
    },
    {
      "name": "logo",
      "type": "image",
      "required": true
    }
  ]
}
